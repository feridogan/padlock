# =================================================================
# KURUMSAL PADLOC - COOLIFY VE DOCKER ORTAM DEĞİŞKENLERİ (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. UYGULAMA VE URL AYARLARI
# -----------------------------------------------------------------
# PWA arayüzünün erişileceği genel URL
PL_PWA_URL=https://pass.feridundogan.com

# Backend API sunucusunun genel erişim URL'si
PL_SERVER_URL=https://api-pass.feridundogan.com

# Servis Portları
PL_TRANSPORT_HTTP_PORT=3000
PL_PWA_PORT=8080

# Uygulama Adı ve Destek
PL_APP_NAME="Kurumsal Kasa"
PL_SUPPORT_EMAIL="destek@feridundogan.com"

# -----------------------------------------------------------------
# 2. VERİ DEPOLAMA (STORAGE & DATABASE)
# -----------------------------------------------------------------
# Depolama arka ucu: leveldb (varsayılan, hafif dosya tabanlı), postgres veya mongodb
PL_DATA_STORAGE_BACKEND=leveldb
PL_DATA_LEVELDB_PATH=/data

# Ek dosyalar (attachments) depolama dizini
PL_ATTACHMENTS_BACKEND=fs
PL_ATTACHMENTS_DIR=/attachments

# -----------------------------------------------------------------
# 3. KİMLİK DOĞRULAMA & ESNEK GİRİŞ AYARLARI
# -----------------------------------------------------------------
# Zorunlu e-posta OTP kodunu devre dışı bırakır; doğrudan kullanıcı adı/e-posta ve şifre ile giriş sağlar
PL_SERVER_DISABLE_MFA=true

# Kayıt sırasında e-posta doğrulama zorunluluğunu kaldırır
PL_SERVER_VERIFY_EMAIL_ON_SIGNUP=false

# -----------------------------------------------------------------
# 4. SMTP / E-POSTA AYARLARI (NODEMAILER ŞİFRE SIFIRLAMA)
# -----------------------------------------------------------------
# E-posta arka ucu: smtp (üretim ortamı için) veya console (geliştirme/test için)
PL_EMAIL_BACKEND=smtp

# Standart SMTP Ayarları
PL_EMAIL_SMTP_HOST=smtp.gmail.com
PL_EMAIL_SMTP_PORT=587
PL_EMAIL_SMTP_SECURE=false
PL_EMAIL_SMTP_USER=bildirim@feridundogan.com
PL_EMAIL_SMTP_PASSWORD=uygulama_sifresi_buraya
PL_EMAIL_SMTP_FROM="Kurumsal Kasa <bildirim@feridundogan.com>"
PL_EMAIL_SMTP_IGNORE_TLS=false

# Coolify / Standart SMTP alternatif değişkenleri (otomatik algılanır):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bildirim@feridundogan.com
# SMTP_PASS=uygulama_sifresi_buraya
# SMTP_FROM=bildirim@feridundogan.com
# SMTP_SECURE=false
